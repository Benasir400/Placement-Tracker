SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/placetrack?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-password
DB_DRIVER=com.mysql.cj.jdbc.Driver
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=placeholder
SMTP_PASSWORD=placeholder
EMAIL_DEVELOPMENT_MODE=true
FRONTEND_BASE_URL=http://127.0.0.1:5173
INVITATION_EXPIRY_HOURS=72
AI_PROVIDER=none
